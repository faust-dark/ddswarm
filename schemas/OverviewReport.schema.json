{
  "$defs": {
    "AgentResultStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "ProvenanceEntry": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "tool_versions": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "title": "Tool Versions",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "input_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Exact"
        },
        "output_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Exact"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "ToolVersion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolVersion",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "agent": {
      "default": "overview_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "user_prompt": {
      "title": "User Prompt",
      "type": "string"
    },
    "mechanism_of_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mechanism Of Action"
    },
    "chemical_structure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chemical Structure"
    },
    "therapeutic_uses": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Therapeutic Uses"
    },
    "citations": {
      "items": {
        "type": "string"
      },
      "title": "Citations",
      "type": "array"
    },
    "own_database_facts": {
      "items": {
        "type": "string"
      },
      "title": "Own Database Facts",
      "type": "array"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "status",
    "user_prompt"
  ],
  "title": "OverviewReport",
  "type": "object"
}