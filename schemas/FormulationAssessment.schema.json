{
  "$defs": {
    "AgentResultStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "EvidenceLevel": {
      "enum": [
        "observed",
        "calculated",
        "predicted",
        "inferred",
        "hypothetical"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "FormulationSummary": {
      "properties": {
        "total_molecules": {
          "default": 0,
          "title": "Total Molecules",
          "type": "integer"
        },
        "bcs_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Bcs Counts",
          "type": "object"
        }
      },
      "title": "FormulationSummary",
      "type": "object"
    },
    "MoleculeFormulation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "canonical_smiles": {
          "title": "Canonical Smiles",
          "type": "string"
        },
        "logp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logp"
        },
        "tpsa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tpsa"
        },
        "solubility_class": {
          "default": "unknown",
          "title": "Solubility Class",
          "type": "string"
        },
        "permeability_class": {
          "default": "unknown",
          "title": "Permeability Class",
          "type": "string"
        },
        "bcs_class": {
          "default": "unknown",
          "title": "Bcs Class",
          "type": "string"
        },
        "ionizable_groups": {
          "items": {
            "type": "string"
          },
          "title": "Ionizable Groups",
          "type": "array"
        },
        "salt_suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Salt Suggestion"
        },
        "prodrug_suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prodrug Suggestion"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "predicted"
        }
      },
      "required": [
        "id",
        "canonical_smiles"
      ],
      "title": "MoleculeFormulation",
      "type": "object"
    },
    "ProvenanceEntry": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "tool_versions": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "title": "Tool Versions",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "input_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Exact"
        },
        "output_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Exact"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "ToolVersion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolVersion",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "agent": {
      "default": "formulation_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "molecules": {
      "items": {
        "$ref": "#/$defs/MoleculeFormulation"
      },
      "title": "Molecules",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/FormulationSummary"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "FormulationAssessment",
  "type": "object"
}