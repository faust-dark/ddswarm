{
  "$defs": {
    "InputType": {
      "enum": [
        "target",
        "ligand",
        "class",
        "mixed"
      ],
      "title": "InputType",
      "type": "string"
    },
    "ProjectStatus": {
      "enum": [
        "draft",
        "approved",
        "running",
        "blocked",
        "completed"
      ],
      "title": "ProjectStatus",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "input_type": {
      "$ref": "#/$defs/InputType"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "title": "Targets",
      "type": "array"
    },
    "starting_materials": {
      "items": {
        "type": "string"
      },
      "title": "Starting Materials",
      "type": "array"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "exclusions": {
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "success_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Success Criteria",
      "type": "array"
    },
    "allowed_tools": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Tools",
      "type": "array"
    },
    "safety_constraints": {
      "items": {
        "type": "string"
      },
      "title": "Safety Constraints",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "draft"
    }
  },
  "required": [
    "project_id",
    "input_type",
    "objective"
  ],
  "title": "ProjectSpec",
  "type": "object"
}