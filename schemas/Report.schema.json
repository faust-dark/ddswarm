{
  "$defs": {
    "AgentResultStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "CandidateSelection": {
      "description": "One ranked candidate from the survivor set. The score is a deterministic\ncomposite over the candidate's computed/predicted properties (see\nReportMinion._rank_survivors); it is a ranking aid, not experimental merit.\n\n`iupac_name` is an optional, HUMAN-READABILITY label fetched from the NIH\nCACTUS web service when the run opts in (`--iupac`). It is non-deterministic\n(network + third-party), NOT authoritative, and excluded from the report's\noutput hash \u2014 canonical SMILES + InChIKey remain the identifiers.",
      "properties": {
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "smiles": {
          "title": "Smiles",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "criteria": {
          "items": {
            "type": "string"
          },
          "title": "Criteria",
          "type": "array"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "iupac_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iupac Name"
        }
      },
      "required": [
        "rank",
        "smiles",
        "score"
      ],
      "title": "CandidateSelection",
      "type": "object"
    },
    "EvidenceBreakdown": {
      "description": "Counts of evidence-carrying units (entries/molecules/endpoints/poses)\nper evidence level. Coarse rollup; individual entries carry finer level.",
      "properties": {
        "observed": {
          "default": 0,
          "title": "Observed",
          "type": "integer"
        },
        "calculated": {
          "default": 0,
          "title": "Calculated",
          "type": "integer"
        },
        "predicted": {
          "default": 0,
          "title": "Predicted",
          "type": "integer"
        },
        "inferred": {
          "default": 0,
          "title": "Inferred",
          "type": "integer"
        },
        "hypothetical": {
          "default": 0,
          "title": "Hypothetical",
          "type": "integer"
        }
      },
      "title": "EvidenceBreakdown",
      "type": "object"
    },
    "ProvenanceEntry": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "tool_versions": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "title": "Tool Versions",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "input_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Exact"
        },
        "output_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Exact"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "StageFinding": {
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "artifact_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Kinds",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "agent",
        "status"
      ],
      "title": "StageFinding",
      "type": "object"
    },
    "ToolVersion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolVersion",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "agent": {
      "default": "report_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "run_status": {
      "title": "Run Status",
      "type": "string"
    },
    "executive_summary": {
      "title": "Executive Summary",
      "type": "string"
    },
    "stage_findings": {
      "items": {
        "$ref": "#/$defs/StageFinding"
      },
      "title": "Stage Findings",
      "type": "array"
    },
    "evidence_breakdown": {
      "$ref": "#/$defs/EvidenceBreakdown"
    },
    "identified_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ranked_candidates": {
      "items": {
        "$ref": "#/$defs/CandidateSelection"
      },
      "title": "Ranked Candidates",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    },
    "next_steps": {
      "items": {
        "type": "string"
      },
      "title": "Next Steps",
      "type": "array"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "run_id",
    "status",
    "run_status",
    "executive_summary"
  ],
  "title": "Report",
  "type": "object"
}