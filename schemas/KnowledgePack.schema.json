{
  "$defs": {
    "AgentResultStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "EvidenceLevel": {
      "enum": [
        "observed",
        "calculated",
        "predicted",
        "inferred",
        "hypothetical"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "KnowledgePackEntry": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "target",
            "ligand",
            "reference",
            "admet",
            "mechanism"
          ],
          "title": "Type",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Value"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "evidence_level"
      ],
      "title": "KnowledgePackEntry",
      "type": "object"
    },
    "ProvenanceEntry": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "tool_versions": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "title": "Tool Versions",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "input_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Exact"
        },
        "output_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Exact"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "ToolVersion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolVersion",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "agent": {
      "default": "researcher_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/KnowledgePackEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "KnowledgePack",
  "type": "object"
}