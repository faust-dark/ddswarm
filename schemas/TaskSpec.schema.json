{
  "$defs": {
    "AttemptRecord": {
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "attempt"
      ],
      "title": "AttemptRecord",
      "type": "object"
    },
    "InputRef": {
      "properties": {
        "ref_type": {
          "title": "Ref Type",
          "type": "string"
        },
        "ref_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Id"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash"
        }
      },
      "required": [
        "ref_type"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "queued",
        "running",
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Task Id"
    },
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "$ref": "#/$defs/InputRef"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus",
      "default": "queued"
    },
    "retry_count": {
      "default": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/AttemptRecord"
      },
      "title": "Attempts",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "agent",
    "project_id",
    "run_id"
  ],
  "title": "TaskSpec",
  "type": "object"
}