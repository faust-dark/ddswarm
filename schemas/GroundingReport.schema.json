{
  "$defs": {
    "AgentResultStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "BindingAffinity": {
      "description": "One measured binding affinity (Ki/Kd/IC50) resolved from ChEMBL for a molecule.",
      "properties": {
        "target_chembl_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Chembl Id"
        },
        "target_pref_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Pref Name"
        },
        "standard_type": {
          "enum": [
            "Ki",
            "Kd",
            "IC50"
          ],
          "title": "Standard Type",
          "type": "string"
        },
        "value_nm": {
          "title": "Value Nm",
          "type": "number"
        },
        "document_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Year"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "observed"
        }
      },
      "required": [
        "standard_type",
        "value_nm"
      ],
      "title": "BindingAffinity",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "observed",
        "calculated",
        "predicted",
        "inferred",
        "hypothetical"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "GroundedEntry": {
      "description": "One external-database record resolved for a molecule.",
      "properties": {
        "source": {
          "enum": [
            "chembl",
            "pubchem",
            "pubmed",
            "drugbank"
          ],
          "title": "Source",
          "type": "string"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "observed"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        }
      },
      "required": [
        "source",
        "external_id",
        "url",
        "title",
        "retrieved_at"
      ],
      "title": "GroundedEntry",
      "type": "object"
    },
    "GroundingSummary": {
      "properties": {
        "total_molecules": {
          "default": 0,
          "title": "Total Molecules",
          "type": "integer"
        },
        "grounded": {
          "default": 0,
          "title": "Grounded",
          "type": "integer"
        },
        "not_found": {
          "default": 0,
          "title": "Not Found",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "total_entries": {
          "default": 0,
          "title": "Total Entries",
          "type": "integer"
        },
        "total_affinities": {
          "default": 0,
          "title": "Total Affinities",
          "type": "integer"
        }
      },
      "title": "GroundingSummary",
      "type": "object"
    },
    "MoleculeGrounding": {
      "description": "Per-molecule grounding result.",
      "properties": {
        "molecule_id": {
          "title": "Molecule Id",
          "type": "string"
        },
        "canonical_smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Smiles"
        },
        "inchi_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inchi Key"
        },
        "status": {
          "enum": [
            "grounded",
            "not_found",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/GroundedEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "binding_affinities": {
          "items": {
            "$ref": "#/$defs/BindingAffinity"
          },
          "title": "Binding Affinities",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "molecule_id",
        "status"
      ],
      "title": "MoleculeGrounding",
      "type": "object"
    },
    "ProvenanceEntry": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "tool_versions": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "title": "Tool Versions",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "input_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Exact"
        },
        "output_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Exact"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "ToolVersion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolVersion",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "agent": {
      "default": "grounding_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "molecules": {
      "items": {
        "$ref": "#/$defs/MoleculeGrounding"
      },
      "title": "Molecules",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/GroundingSummary"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "GroundingReport",
  "type": "object"
}