{
  "$defs": {
    "AdrInterpretation": {
      "description": "Pluggable adverse-effect interpretation for a matching receptor panel.",
      "properties": {
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "profile",
        "label"
      ],
      "title": "AdrInterpretation",
      "type": "object"
    },
    "AgentResultStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "EvidenceLevel": {
      "enum": [
        "observed",
        "calculated",
        "predicted",
        "inferred",
        "hypothetical"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "MoleculeSelectivity": {
      "properties": {
        "molecule_id": {
          "title": "Molecule Id",
          "type": "string"
        },
        "canonical_smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Smiles"
        },
        "primary_receptor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Receptor"
        },
        "affinities": {
          "items": {
            "$ref": "#/$defs/ReceptorAffinity"
          },
          "title": "Affinities",
          "type": "array"
        },
        "selectivity_indices": {
          "items": {
            "$ref": "#/$defs/SelectivityIndex"
          },
          "title": "Selectivity Indices",
          "type": "array"
        },
        "adr": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdrInterpretation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "calculated"
        }
      },
      "required": [
        "molecule_id"
      ],
      "title": "MoleculeSelectivity",
      "type": "object"
    },
    "ProvenanceEntry": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "tool_versions": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "title": "Tool Versions",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "input_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Exact"
        },
        "output_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Exact"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "ReceptorAffinity": {
      "properties": {
        "receptor": {
          "title": "Receptor",
          "type": "string"
        },
        "pdb_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdb Id"
        },
        "best_affinity_kcal_per_mol": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Affinity Kcal Per Mol"
        },
        "ki_molar": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ki Molar"
        },
        "occupancy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupancy"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "calculated"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "receptor"
      ],
      "title": "ReceptorAffinity",
      "type": "object"
    },
    "SelectivityIndex": {
      "description": "Ki_off / Ki_primary for one off-target vs the designated primary.",
      "properties": {
        "off_target": {
          "title": "Off Target",
          "type": "string"
        },
        "primary": {
          "title": "Primary",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "calculated"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "off_target",
        "primary"
      ],
      "title": "SelectivityIndex",
      "type": "object"
    },
    "SelectivitySummary": {
      "properties": {
        "total_molecules": {
          "default": 0,
          "title": "Total Molecules",
          "type": "integer"
        },
        "assessed": {
          "default": 0,
          "title": "Assessed",
          "type": "integer"
        },
        "insufficient_data": {
          "default": 0,
          "title": "Insufficient Data",
          "type": "integer"
        },
        "primary_receptor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Receptor"
        }
      },
      "title": "SelectivitySummary",
      "type": "object"
    },
    "ToolVersion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolVersion",
      "type": "object"
    },
    "VinaCalibration": {
      "description": "Hybrid Vina-score calibration (offset-only, per-receptor intercept).",
      "properties": {
        "method": {
          "default": "offset-only per-receptor calibration: slope a = 1 (fixed), intercept b_r = mean(\u0394G_literature \u2212 Vina_score)",
          "title": "Method",
          "type": "string"
        },
        "slope": {
          "default": 1.0,
          "title": "Slope",
          "type": "number"
        },
        "intercepts": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Intercepts",
          "type": "object"
        },
        "n_points": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "N Points",
          "type": "object"
        },
        "rmsd_kcal_per_mol": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Rmsd Kcal Per Mol",
          "type": "object"
        },
        "calibration_source": {
          "default": "NIMH PDSP Ki Database (https://pdsp.unc.edu/databases/pdsp.php); literature Ki values \u2014 verify against the primary source",
          "title": "Calibration Source",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "VinaCalibration",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "agent": {
      "default": "selectivity_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "molecules": {
      "items": {
        "$ref": "#/$defs/MoleculeSelectivity"
      },
      "title": "Molecules",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/SelectivitySummary"
    },
    "reference_concentration_molar": {
      "default": 1e-08,
      "title": "Reference Concentration Molar",
      "type": "number"
    },
    "primary_receptor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Receptor"
    },
    "reference_molecule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Molecule"
    },
    "reference_primary_occupancy": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Primary Occupancy"
    },
    "calibration": {
      "anyOf": [
        {
          "$ref": "#/$defs/VinaCalibration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "SelectivityAssessment",
  "type": "object"
}