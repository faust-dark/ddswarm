{
  "$defs": {
    "AgentResultStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "CypLiability": {
      "properties": {
        "enzyme": {
          "enum": [
            "CYP3A4",
            "CYP2D6",
            "CYP2C9",
            "CYP2C19",
            "CYP1A2"
          ],
          "title": "Enzyme",
          "type": "string"
        },
        "effect": {
          "enum": [
            "inhibition",
            "induction"
          ],
          "title": "Effect",
          "type": "string"
        },
        "alert_slug": {
          "title": "Alert Slug",
          "type": "string"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "predicted"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "enzyme",
        "effect",
        "alert_slug",
        "citation"
      ],
      "title": "CypLiability",
      "type": "object"
    },
    "CypSummary": {
      "properties": {
        "total_molecules": {
          "default": 0,
          "title": "Total Molecules",
          "type": "integer"
        },
        "flagged_inhibition": {
          "default": 0,
          "title": "Flagged Inhibition",
          "type": "integer"
        },
        "flagged_induction": {
          "default": 0,
          "title": "Flagged Induction",
          "type": "integer"
        },
        "total_alerts": {
          "default": 0,
          "title": "Total Alerts",
          "type": "integer"
        }
      },
      "title": "CypSummary",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "observed",
        "calculated",
        "predicted",
        "inferred",
        "hypothetical"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "MoleculeCypProfile": {
      "properties": {
        "molecule_id": {
          "title": "Molecule Id",
          "type": "string"
        },
        "canonical_smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Smiles"
        },
        "liabilities": {
          "items": {
            "$ref": "#/$defs/CypLiability"
          },
          "title": "Liabilities",
          "type": "array"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "predicted"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "molecule_id"
      ],
      "title": "MoleculeCypProfile",
      "type": "object"
    },
    "ProvenanceEntry": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "tool_versions": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "title": "Tool Versions",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "input_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Exact"
        },
        "output_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Exact"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "ToolVersion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolVersion",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "agent": {
      "default": "cyp_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "molecules": {
      "items": {
        "$ref": "#/$defs/MoleculeCypProfile"
      },
      "title": "Molecules",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/CypSummary"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "CypAssessment",
  "type": "object"
}