    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "agent": {
      "default": "clinical_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "simulations": {
      "items": {
        "$ref": "#/$defs/PKSimulation"
      },
      "title": "Simulations",
      "type": "array"
    },
    "pd_simulations": {
      "items": {
        "$ref": "#/$defs/PDSimulation"
      },
      "title": "Pd Simulations",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/ClinicalSimulationSummary"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
