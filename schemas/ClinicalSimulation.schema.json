            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cmax Mg L"
        },
        "auc_mg_h_l": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auc Mg H L"
        },
        "concentration_curve": {
          "items": {
            "$ref": "#/$defs/ConcentrationPoint"
          },
          "title": "Concentration Curve",
          "type": "array"
