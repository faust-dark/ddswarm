{
  "$defs": {
    "AgentResultStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked",
        "insufficient_evidence"
      ],
      "title": "AgentResultStatus",
      "type": "string"
    },
    "EvidenceLevel": {
      "enum": [
        "observed",
        "calculated",
        "predicted",
        "inferred",
        "hypothetical"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "ProvenanceEntry": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "tool_versions": {
          "items": {
            "$ref": "#/$defs/ToolVersion"
          },
          "title": "Tool Versions",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "input_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "input_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Exact"
        },
        "output_exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Exact"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "RetrosynthesisEntry": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "canonical_smiles": {
          "title": "Canonical Smiles",
          "type": "string"
        },
        "sa_score": {
          "title": "Sa Score",
          "type": "number"
        },
        "synthetic_accessibility": {
          "enum": [
            "easy",
            "moderate",
            "hard"
          ],
          "title": "Synthetic Accessibility",
          "type": "string"
        },
        "disconnections": {
          "items": {
            "$ref": "#/$defs/RetrosyntheticDisconnection"
          },
          "title": "Disconnections",
          "type": "array"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/SynthesisRoute"
          },
          "title": "Routes",
          "type": "array"
        },
        "feasibility_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feasibility Note"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "calculated"
        }
      },
      "required": [
        "id",
        "canonical_smiles",
        "sa_score",
        "synthetic_accessibility"
      ],
      "title": "RetrosynthesisEntry",
      "type": "object"
    },
    "RetrosynthesisSummary": {
      "properties": {
        "total_molecules": {
          "default": 0,
          "title": "Total Molecules",
          "type": "integer"
        },
        "easy": {
          "default": 0,
          "title": "Easy",
          "type": "integer"
        },
        "moderate": {
          "default": 0,
          "title": "Moderate",
          "type": "integer"
        },
        "hard": {
          "default": 0,
          "title": "Hard",
          "type": "integer"
        },
        "molecules_with_routes": {
          "default": 0,
          "title": "Molecules With Routes",
          "type": "integer"
        }
      },
      "title": "RetrosynthesisSummary",
      "type": "object"
    },
    "RetrosyntheticDisconnection": {
      "description": "A deterministic retrosynthetic disconnection: the molecule decomposed\ninto building blocks by BRICS rules. Fragments carry attachment-point\nmarkers ([n*]) showing where bonds break. A theoretical route, not a\ndemonstrated synthesis \u2014 building-block commercial availability is never\nassessed here. When `fragments` is empty the molecule has no BRICS\ndisconnection point (a fused/aromatic scaffold built via ring-forming\nchemistry), which the note explains.",
      "properties": {
        "fragments": {
          "items": {
            "type": "string"
          },
          "title": "Fragments",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "calculated"
        }
      },
      "title": "RetrosyntheticDisconnection",
      "type": "object"
    },
    "SynthesisRoute": {
      "description": "An LLM-proposed synthesis route (hypothetical, not demonstrated).\n\n`procedure` is a human-readable, verbatim synthesis METHOD \u2014 a short\nnarrative a bench chemist could start from, naming the starting material\n(a pre-existing derivative of the same therapeutic/chemical class when one\nexists, otherwise simpler/commercially-available precursors) and the\nliterature-confirmed reactions/conditions. It is LLM-recalled\n(evidence_level=hypothetical), never a validated protocol.",
      "properties": {
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "key_reagents": {
          "items": {
            "type": "string"
          },
          "title": "Key Reagents",
          "type": "array"
        },
        "procedure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Procedure"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "feasibility_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feasibility Note"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "hypothetical"
        }
      },
      "title": "SynthesisRoute",
      "type": "object"
    },
    "ToolVersion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolVersion",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "agent": {
      "default": "retrosynthesis_minion",
      "title": "Agent",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentResultStatus"
    },
    "molecules": {
      "items": {
        "$ref": "#/$defs/RetrosynthesisEntry"
      },
      "title": "Molecules",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/RetrosynthesisSummary"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "RetrosynthesisPlan",
  "type": "object"
}